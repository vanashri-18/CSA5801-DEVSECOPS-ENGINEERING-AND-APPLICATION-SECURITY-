server <- function(input, output, session) {
  data_rv <- reactiveVal(generate_data())
  rem_rv <- reactiveVal(NULL)
  mc_rv <- reactiveVal(NULL)

  observeEvent(input$regenerate, {
    data_rv(generate_data(input$n,input$seed))
    rem_rv(NULL); mc_rv(NULL)
  })

  d <- reactive(data_rv())

  output$totalBox <- renderValueBox(valueBox(nrow(d()),"Total Vulnerabilities",icon=icon("bug"),color="blue"))
  output$criticalBox <- renderValueBox(valueBox(sum(d()$Severity=="Critical"),"Critical Findings",icon=icon("triangle-exclamation"),color="red"))
  output$fixedBox <- renderValueBox(sum(d()$Remediation=="Fixed") |> valueBox("Fixed Findings",icon=icon("check"),color="green"))

  risk_initial <- reactive(sum(d()$Risk_Score))
  output$riskBox <- renderValueBox(valueBox(round(risk_initial()),"Initial Risk Score",icon=icon("gauge-high"),color="yellow"))

  output$dataTable <- renderDT(datatable(d(),filter="top",options=list(pageLength=15,scrollX=TRUE)),server=FALSE)

  output$severityPlot <- renderPlotly({
    x <- d() %>% count(Severity)
    ggplotly(ggplot(x,aes(Severity,n,fill=Severity))+geom_col()+theme_minimal()+
               labs(x=NULL,y="Count"))
  })
  output$vulnPlot <- renderPlotly({
    x <- d() %>% count(Vulnerability,sort=TRUE)
    ggplotly(ggplot(x,aes(reorder(Vulnerability,n),n))+geom_col()+
               coord_flip()+theme_minimal()+labs(x=NULL,y="Count"))
  })
  output$cvssPlot <- renderPlotly({
    ggplotly(ggplot(d(),aes(CVSS))+geom_histogram(bins=20)+theme_minimal()+
               labs(x="CVSS",y="Frequency"))
  })

  output$summaryTable <- renderTable({
    data.frame(
      Metric=c("Records","Average CVSS","Average Risk","Detected %","Fixed %"),
      Value=c(nrow(d()),round(mean(d()$CVSS),2),
              round(mean(d()$Risk_Score),2),
              round(mean(d()$Detection_Status=="Detected")*100,2),
              round(mean(d()$Remediation=="Fixed")*100,2))
    )
  })

  output$componentTable <- renderDT({
    x <- d() %>% group_by(Component) %>%
      summarise(Vulnerabilities=n(),Average_CVSS=round(mean(CVSS),2),
                Average_Risk=round(mean(Risk_Score),2),
                Critical=sum(Severity=="Critical"),
                High=sum(Severity=="High"),.groups="drop") %>%
      arrange(desc(Average_Risk))
    datatable(x,options=list(pageLength=10))
  })

  observeEvent(input$runRem, {
    set.seed(input$seed+99)
    x <- d()
    probs <- c(Critical=input$critical_p,High=input$high_p,
               Medium=input$medium_p,Low=input$low_p)
    fixed <- mapply(function(s) runif(1)<probs[as.character(s)], x$Severity)
    x$Simulated_Remediation <- ifelse(fixed,"Fixed","Pending")
    rem_rv(x)
  }, ignoreInit=FALSE)

  rem_data <- reactive({
    if(!is.null(rem_rv())) rem_rv() else {
      set.seed(input$seed+99)
      x <- d()
      probs <- c(Critical=input$critical_p,High=input$high_p,Medium=input$medium_p,Low=input$low_p)
      fixed <- mapply(function(s) runif(1)<probs[as.character(s)], x$Severity)
      x$Simulated_Remediation <- ifelse(fixed,"Fixed","Pending")
      x
    }
  })

  before <- reactive(sum(rem_data()$Risk_Score))
  after <- reactive(sum(rem_data()$Risk_Score[rem_data()$Simulated_Remediation=="Pending"]))
  reduction <- reactive((before()-after())/before()*100)

  output$beforeBox <- renderValueBox(valueBox(round(before()),"Before Risk",icon=icon("shield"),color="red"))
  output$afterBox <- renderValueBox(valueBox(round(after()),"After Risk",icon=icon("shield-halved"),color="orange"))
  output$reductionBox <- renderValueBox(valueBox(paste0(round(reduction(),2),"%"),"Risk Reduction",icon=icon("arrow-down"),color="green"))

  output$beforeAfterPlot <- renderPlotly({
    b <- rem_data() %>% count(Severity) %>% mutate(Stage="Before")
    a <- rem_data() %>% filter(Simulated_Remediation=="Pending") %>% count(Severity) %>% mutate(Stage="After")
    x <- bind_rows(b,a)
    ggplotly(ggplot(x,aes(Severity,n,fill=Stage))+geom_col(position="dodge")+
               theme_minimal()+labs(x=NULL,y="Vulnerabilities"))
  })

  observeEvent(list(input$runRem,input$iterations,input$rem_prob,input$regenerate), {
    set.seed(input$seed+777)
    x <- d()
    res <- numeric(input$iterations)
    for(i in seq_len(input$iterations)) {
      p <- input$rem_prob
      fixed <- runif(nrow(x)) < p
      res[i] <- sum(x$Risk_Score[!fixed])
    }
    mc_rv(data.frame(Simulation=seq_along(res),Remaining_Risk=res))
  }, ignoreInit=FALSE)

  output$mcMeanBox <- renderValueBox(valueBox(round(mean(mc_rv()$Remaining_Risk)),"Mean Remaining Risk",icon=icon("chart-line"),color="blue"))
  output$mcMinBox <- renderValueBox(valueBox(round(min(mc_rv()$Remaining_Risk)),"Minimum Risk",icon=icon("arrow-down"),color="green"))
  output$mcMaxBox <- renderValueBox(valueBox(round(max(mc_rv()$Remaining_Risk)),"Maximum Risk",icon=icon("arrow-up"),color="red"))

  output$mcPlot <- renderPlotly({
    ggplotly(ggplot(mc_rv(),aes(Remaining_Risk))+geom_histogram(bins=30)+theme_minimal()+
               labs(x="Remaining Risk",y="Frequency"))
  })

  output$mcTable <- renderTable({
    x <- mc_rv()$Remaining_Risk
    data.frame(
      Metric=c("Iterations","Mean","Minimum","Maximum","Standard Deviation"),
      Value=c(length(x),round(mean(x),2),round(min(x),2),round(max(x),2),round(sd(x),2))
    )
  })

  output$downloadCSV <- downloadHandler(
    filename=function() paste0("sast_synthetic_dataset_",nrow(d()),".csv"),
    content=function(file) write_csv(d(),file)
  )
  output$downloadResults <- downloadHandler(
    filename=function() "sast_final_results.csv",
    content=function(file) {
      x <- data.frame(
        Metric=c("Total Vulnerabilities","Critical","High","Medium","Low",
                 "Initial Risk","Final Risk","Risk Reduction %",
                 "Average CVSS","Detected %","Fixed %"),
        Value=c(nrow(d()),sum(d()$Severity=="Critical"),sum(d()$Severity=="High"),
                sum(d()$Severity=="Medium"),sum(d()$Severity=="Low"),
                round(before(),2),round(after(),2),round(reduction(),2),
                round(mean(d()$CVSS),2),
                round(mean(d()$Detection_Status=="Detected")*100,2),
                round(mean(d()$Remediation=="Fixed")*100,2))
      )
      write_csv(x,file)
    }
  )
  output$downloadMC <- downloadHandler(
    filename=function() "sast_monte_carlo_results.csv",
    content=function(file) write_csv(mc_rv(),file)
  )
  output$downloadReport <- downloadHandler(
    filename=function() "SAST_Simulation_Summary.html",
    content=function(file) {
      html <- paste0(
        "<html><head><title>SAST Simulation Summary</title>",
        "<style>body{font-family:Arial;margin:40px}table{border-collapse:collapse}td,th{border:1px solid #ccc;padding:8px}</style>",
        "</head><body><h1>SAST Simulation & Modelling</h1>",
        "<h2>Project Summary</h2>",
        "<p>This project simulates Static Application Security Testing using a synthetic dataset of ",
        nrow(d())," vulnerability findings. It classifies findings by CVSS/severity, estimates risk, ",
        "simulates remediation, and evaluates residual risk using Monte Carlo simulation.</p>",
        "<h2>Key Results</h2><table>",
        "<tr><th>Metric</th><th>Value</th></tr>",
        "<tr><td>Total vulnerabilities</td><td>",nrow(d()),"</td></tr>",
        "<tr><td>Critical findings</td><td>",sum(d()$Severity=="Critical"),"</td></tr>",
        "<tr><td>Initial risk</td><td>",round(before(),2),"</td></tr>",
        "<tr><td>Final risk</td><td>",round(after(),2),"</td></tr>",
        "<tr><td>Risk reduction</td><td>",round(reduction(),2),"%</td></tr>",
        "<tr><td>Monte Carlo mean risk</td><td>",round(mean(mc_rv()$Remaining_Risk),2),"</td></tr>",
        "</table><h2>Conclusion</h2><p>The simulation demonstrates how SAST-style findings can be prioritized using severity and CVSS, and how remediation can reduce residual application security risk. Monte Carlo modelling illustrates the range of possible remaining risk under different remediation probabilities.</p>",
        "</body></html>"
      )
      writeLines(html,file)
    }
  )
}

shinyApp(ui, server)
