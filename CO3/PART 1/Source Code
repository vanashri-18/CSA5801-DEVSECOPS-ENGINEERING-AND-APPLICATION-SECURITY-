generate_data <- function(n=1200, seed=123) {
  set.seed(seed)
  vulns <- c("SQL Injection","Cross-Site Scripting","Command Injection",
             "Hardcoded Credentials","Weak Authentication","Insecure API",
             "Path Traversal","Buffer Overflow","Insecure Cryptography",
             "Sensitive Data Exposure")
  cwes <- c("CWE-89","CWE-79","CWE-78","CWE-798","CWE-287",
            "CWE-639","CWE-22","CWE-120","CWE-327","CWE-200")
  languages <- c("Python","Java","JavaScript","C","C++","PHP")
  components <- c("Authentication","Database","API","Payment","File Upload",
                  "User Management","Session Management","Configuration")
  files <- c("login","auth","user","admin","payment","database","api",
             "upload","download","config","profile","session","search",
             "checkout","server")
  exts <- c(".py",".java",".js",".c",".cpp",".php")
  idx <- sample(seq_along(vulns), n, TRUE)
  cvss <- round(runif(n, 2, 10), 1)
  severity <- case_when(cvss >= 9 ~ "Critical", cvss >= 7 ~ "High",
                        cvss >= 4 ~ "Medium", TRUE ~ "Low")
  weight <- case_when(severity=="Critical"~1.5, severity=="High"~1.2,
                      severity=="Medium"~1.0, TRUE~0.7)
  remediation <- sapply(severity, function(x) {
    p <- switch(x, Critical=.75, High=.60, Medium=.45, Low=.30)
    if(runif(1) < p) "Fixed" else "Pending"
  })
  data.frame(
    ID=sprintf("V%04d",1:n),
    File_Name=paste0(sample(files,n,TRUE),sample(exts,n,TRUE)),
    Language=sample(languages,n,TRUE),
    Component=sample(components,n,TRUE),
    Vulnerability=vulns[idx],
    CWE=cwes[idx],
    Line_Number=sample(10:1500,n,TRUE),
    CVSS=cvss,
    Severity=factor(severity, levels=c("Low","Medium","High","Critical")),
    Risk_Score=round(cvss*weight,2),
    Detection_Status=sample(c("Detected","Missed"),n,TRUE,prob=c(.80,.20)),
    Remediation=remediation,
    stringsAsFactors=FALSE
  )
}

