gen_dast <- function(n=1200, seed=123){
 set.seed(seed)
 vul <- c("SQL Injection","Cross-Site Scripting","CSRF","Security Misconfiguration",
          "Broken Authentication","Path Traversal","Open Redirect",
          "Missing Security Headers","Session Management Issue","Information Disclosure")
 urls <- c("/login","/admin","/api/users","/search","/upload","/payment","/profile",
           "/checkout","/api/auth","/download")
 methods <- c("GET","POST","PUT","DELETE")
 cv <- round(runif(n,2,10),1)
 sev <- case_when(cv>=9~"Critical",cv>=7~"High",cv>=4~"Medium",TRUE~"Low")
 data.frame(Scan_ID=sprintf("DAST%04d",1:n),URL=sample(urls,n,TRUE),
 HTTP_Method=sample(methods,n,TRUE),Vulnerability=sample(vul,n,TRUE),
 Parameter=sample(c("username","id","search","file","token","redirect","N/A"),n,TRUE),
 CVSS=cv,Severity=factor(sev,levels=c("Low","Medium","High","Critical")),
 Status=sample(c("Open","Open","Open","Fixed"),n,TRUE),stringsAsFactors=FALSE)
}
gen_sca <- function(n=1200, seed=456){
 set.seed(seed)
 packages <- c("log4j","lodash","axios","express","jquery","openssl","spring-core",
               "jackson-databind","django","flask","requests","react","moment","webpack","npm")
 cves <- c("CVE-2021-44228","CVE-2021-23337","CVE-2021-3749","CVE-2022-24999",
           "CVE-2020-11022","CVE-2022-3602","CVE-2022-22965","CVE-2020-36518",
           "CVE-2023-24580","CVE-2023-30861")
 cv <- round(runif(n,2,10),1)
 sev <- case_when(cv>=9~"Critical",cv>=7~"High",cv>=4~"Medium",TRUE~"Low")
 data.frame(SCA_ID=sprintf("SCA%04d",1:n),Package=sample(packages,n,TRUE),
 Version=paste0(sample(0:4,n,TRUE),".",sample(0:20,n,TRUE),".",sample(0:30,n,TRUE)),
 CVE=sample(cves,n,TRUE),Dependency_Type=sample(c("Direct","Transitive"),n,TRUE),
 License=sample(c("MIT","Apache-2.0","GPL-3.0","BSD-3-Clause","Unknown"),n,TRUE),
 CVSS=cv,Severity=factor(sev,levels=c("Low","Medium","High","Critical")),
 Status=sample(c("Vulnerable","Vulnerable","Vulnerable","Updated"),n,TRUE),
 stringsAsFactors=FALSE)
}

