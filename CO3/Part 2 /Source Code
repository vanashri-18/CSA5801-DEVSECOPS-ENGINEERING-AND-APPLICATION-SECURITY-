server <- function(input,output,session){
 rv <- reactiveValues(dast=gen_dast(),sca=gen_sca(),rem=NULL,mc=NULL)
 observeEvent(input$regen,{rv$dast<-gen_dast(input$n,input$seed);rv$sca<-gen_sca(input$n,input$seed+1);rv$rem<-NULL})
 riskfun <- function(x) sum(x$CVSS)
 output$dastBox<-renderValueBox(valueBox(nrow(rv$dast),"DAST Findings",icon=icon("globe"),color="blue"))
 output$scaBox<-renderValueBox(valueBox(nrow(rv$sca),"SCA Findings",icon=icon("boxes-stacked"),color="aqua"))
 output$critBox<-renderValueBox(valueBox(sum(rv$dast$Severity=="Critical")+sum(rv$sca$Severity=="Critical"),
                                         "Critical Findings",icon=icon("triangle-exclamation"),color="red"))
 output$riskBox<-renderValueBox(valueBox(round(riskfun(rv$dast)+riskfun(rv$sca)),"Combined Risk",icon=icon("gauge"),color="yellow"))
 output$dastTable<-renderDT(datatable(rv$dast,filter="top",options=list(pageLength=15,scrollX=TRUE)),server=FALSE)
 output$scaTable<-renderDT(datatable(rv$sca,filter="top",options=list(pageLength=15,scrollX=TRUE)),server=FALSE)
 output$dastSev<-renderPlotly({x<-rv$dast%>%count(Severity);ggplotly(ggplot(x,aes(Severity,n,fill=Severity))+geom_col()+theme_minimal())})
 output$scaSev<-renderPlotly({x<-rv$sca%>%count(Severity);ggplotly(ggplot(x,aes(Severity,n,fill=Severity))+geom_col()+theme_minimal())})
 output$dastTypes<-renderPlotly({x<-rv$dast%>%count(Vulnerability,sort=TRUE);ggplotly(ggplot(x,aes(reorder(Vulnerability,n),n))+geom_col()+coord_flip()+theme_minimal())})
 output$dastCVSS<-renderPlotly({ggplotly(ggplot(rv$dast,aes(CVSS))+geom_histogram(bins=20)+theme_minimal())})
 output$scaPkg<-renderPlotly({x<-rv$sca%>%count(Package,sort=TRUE);ggplotly(ggplot(x,aes(reorder(Package,n),n))+geom_col()+coord_flip()+theme_minimal())})
 output$scaCVSS<-renderPlotly({ggplotly(ggplot(rv$sca,aes(CVSS))+geom_histogram(bins=20)+theme_minimal())})
 dr<-reactive(sum(rv$dast$CVSS)); sr<-reactive(sum(rv$sca$CVSS)); orisk<-reactive(dr()+sr())
 output$dRisk<-renderValueBox(valueBox(round(dr()),"DAST Risk",icon=icon("globe"),color="blue"))
 output$sRisk<-renderValueBox(valueBox(round(sr()),"SCA Risk",icon=icon("boxes-stacked"),color="aqua"))
 output$overall<-renderValueBox(valueBox(round(orisk()),"Overall Risk",icon=icon("shield"),color="red"))
 output$riskPlot<-renderPlotly({x<-data.frame(Type=c("DAST","SCA"),Risk=c(dr(),sr()));ggplotly(ggplot(x,aes(Type,Risk,fill=Type))+geom_col()+theme_minimal())})
 output$riskTable<-renderTable({
   total<-nrow(rv$dast)+nrow(rv$sca); avg<-(mean(rv$dast$CVSS)+mean(rv$sca$CVSS))/2
   rating<-if(avg>=9)"Critical" else if(avg>=7)"High" else if(avg>=4)"Medium" else "Low"
   data.frame(Metric=c("Total Findings","Average CVSS","Critical Findings","Security Rating"),
              Value=c(total,round(avg,2),sum(rv$dast$Severity=="Critical")+sum(rv$sca$Severity=="Critical"),rating))
 })
 make_rem <- function(){
   set.seed(input$seed+99); d<-rv$dast;s<-rv$sca
   p<-c(Critical=input$critical,High=input$high,Medium=input$medium,Low=input$low)
   fd<-mapply(function(z)runif(1)<p[as.character(z)],d$Severity)
   fs<-mapply(function(z)runif(1)<p[as.character(z)],s$Severity)
   list(d=d, s=s, fd=fd, fs=fs)
 }
 observeEvent(input$runRem,{rv$rem<-make_rem()})
 rem<-reactive(if(is.null(rv$rem))make_rem() else rv$rem)
 before<-reactive(sum(rem()$d$CVSS)+sum(rem()$s$CVSS))
 after<-reactive(sum(rem()$d$CVSS[!rem()$fd])+sum(rem()$s$CVSS[!rem()$fs]))
 red<-reactive((before()-after())/before()*100)
 output$before<-renderValueBox(valueBox(round(before()),"Before Risk",icon=icon("shield"),color="red"))
 output$after<-renderValueBox(valueBox(round(after()),"After Risk",icon=icon("shield-halved"),color="orange"))
 output$reduction<-renderValueBox(valueBox(paste0(round(red(),2),"%"),"Risk Reduction",icon=icon("arrow-down"),color="green"))
 output$remPlot<-renderPlotly({x<-data.frame(Stage=c("Before","After"),Risk=c(before(),after()));ggplotly(ggplot(x,aes(Stage,Risk,fill=Stage))+geom_col()+theme_minimal())})
 observeEvent(list(input$runRem,input$iters,input$remp,input$regen),{
   set.seed(input$seed+777);x<-c(rv$dast$CVSS,rv$sca$CVSS);r<-numeric(input$iters)
   for(i in seq_len(input$iters)){fixed<-runif(length(x))<input$remp;r[i]<-sum(x[!fixed])}
   rv$mc<-data.frame(Simulation=seq_along(r),Remaining_Risk=r)
 },ignoreInit=FALSE)
 output$mcmean<-renderValueBox(valueBox(round(mean(rv$mc$Remaining_Risk)),"Mean Residual Risk",icon=icon("chart-line"),color="blue"))
 output$mcmin<-renderValueBox(valueBox(round(min(rv$mc$Remaining_Risk)),"Minimum Risk",icon=icon("arrow-down"),color="green"))
 output$mcmax<-renderValueBox(valueBox(round(max(rv$mc$Remaining_Risk)),"Maximum Risk",icon=icon("arrow-up"),color="red"))
 output$mcplot<-renderPlotly({ggplotly(ggplot(rv$mc,aes(Remaining_Risk))+geom_histogram(bins=30)+theme_minimal())})
 output$mctable<-renderTable({x<-rv$mc$Remaining_Risk;data.frame(Metric=c("Iterations","Mean","Minimum","Maximum","SD"),Value=c(length(x),round(mean(x),2),round(min(x),2),round(max(x),2),round(sd(x),2)))})
 output$dastDL<-downloadHandler("dast_synthetic_dataset.csv",function(f)write_csv(rv$dast,f))
 output$scaDL<-downloadHandler("sca_synthetic_dataset.csv",function(f)write_csv(rv$sca,f))
 output$resultDL<-downloadHandler("dast_sca_final_results.csv",function(f){
   z<-data.frame(Metric=c("DAST Findings","SCA Findings","DAST Risk","SCA Risk","Overall Risk","Average CVSS","Risk Reduction %"),
                  Value=c(nrow(rv$dast),nrow(rv$sca),dr(),sr(),orisk(),
                          (mean(rv$dast$CVSS)+mean(rv$sca$CVSS))/2,red()))
   write_csv(z,f)})
 output$mcDL<-downloadHandler("monte_carlo_results.csv",function(f)write_csv(rv$mc,f))
 output$htmlDL<-downloadHandler("DAST_SCA_Security_Report.html",function(f){
   html<-paste0("<html><head><title>DAST + SCA Security Verification</title><style>body{font-family:Arial;margin:40px}td,th{padding:8px;border:1px solid #ccc}</style></head><body>",
   "<h1>DAST + SCA Security Verification</h1><p>This report summarizes a synthetic simulation of Dynamic Application Security Testing and Software Composition Analysis.</p>",
   "<table><tr><th>Metric</th><th>Value</th></tr>",
   "<tr><td>DAST findings</td><td>",nrow(rv$dast),"</td></tr>",
   "<tr><td>SCA findings</td><td>",nrow(rv$sca),"</td></tr>",
   "<tr><td>DAST risk</td><td>",round(dr(),2),"</td></tr>",
   "<tr><td>SCA risk</td><td>",round(sr(),2),"</td></tr>",
   "<tr><td>Overall risk</td><td>",round(orisk(),2),"</td></tr>",
   "<tr><td>Risk reduction</td><td>",round(red(),2),"%</td></tr></table>",
   "<h2>Conclusion</h2><p>The combined simulation evaluates runtime web vulnerabilities and third-party dependency risks. Remediation and Monte Carlo modelling demonstrate how security risk can be reduced and how residual risk varies under different remediation conditions.</p></body></html>")
   writeLines(html,f)
 })
}
shinyApp(ui,server)
