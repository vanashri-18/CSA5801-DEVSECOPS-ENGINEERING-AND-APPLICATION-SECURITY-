generate_data <- function(n=1500, seed=123){
 set.seed(seed)
 vul <- c("SQL Injection","Cross-Site Scripting","Command Injection",
          "Hardcoded Credentials","Weak Authentication","Insecure API",
          "Path Traversal","Buffer Overflow","Insecure Cryptography",
          "Sensitive Data Exposure","Vulnerable Dependency","CSRF")
 sources <- c("SAST","DAST","SCA")
 comps <- c("Authentication","Database","API","Payment","File Upload",
            "User Management","Session Management","Configuration")
 cv <- round(runif(n,2,10),1)
 sev <- case_when(cv>=9~"Critical",cv>=7~"High",cv>=4~"Medium",TRUE~"Low")
 det <- sample(c("Detected","Missed"),n,TRUE,prob=c(.88,.12))
 verified <- ifelse(det=="Detected",
                    sample(c("Verified","Failed"),n,TRUE,prob=c(.90,.10)),
                    "Not Verified")
 fixed <- ifelse(verified=="Verified",
                 sample(c("Fixed","Pending"),n,TRUE,prob=c(.72,.28)),
                 "Pending")
 retest <- ifelse(fixed=="Fixed",
                  sample(c("Passed","Failed"),n,TRUE,prob=c(.94,.06)),
                  "Not Tested")
 data.frame(
   ID=sprintf("V%04d",1:n),
   Source=sample(sources,n,TRUE),
   Component=sample(comps,n,TRUE),
   Vulnerability=sample(vul,n,TRUE),
   CVSS=cv,
   Severity=factor(sev,levels=c("Low","Medium","High","Critical")),
   Detection=det,
   Verification=verified,
   Remediation=fixed,
   ReTest=retest,
   Detection_Time=round(runif(n,.5,8),2),
   Remediation_Time=round(runif(n,1,48),2),
   stringsAsFactors=FALSE
 )
}

