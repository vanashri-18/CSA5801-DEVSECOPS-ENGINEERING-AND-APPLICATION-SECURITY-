# IaCGuardian - Module 5: Interactive Security Visualization
pkgs<-c("shiny","shinydashboard","DT","ggplot2","plotly","dplyr","DiagrammeR")
miss<-pkgs[!sapply(pkgs,requireNamespace,quietly=TRUE)]
if(length(miss))install.packages(miss,repos="https://cloud.r-project.org")
lapply(pkgs,library,character.only=TRUE)
make_data<-function(n=1000,seed=2608){set.seed(seed);d<-data.frame(Asset_ID=sprintf("ASSET-%04d",1:n),Resource_Type=sample(c("EC2","IAM","Lambda","RDS","S3","VPC"),n,TRUE),Risk_Score=round(runif(n,10,100),2),Open_Ports=sample(0:12,n,TRUE),Dependency_Count=sample(1:10,n,TRUE),Vulnerability_Count=sample(0:7,n,TRUE));d$Risk_Level<-as.character(cut(d$Risk_Score,c(-Inf,30,50,75,Inf),labels=c("Low","Medium","High","Critical"),right=FALSE));d}
data<-if(file.exists("final_iacguardian_dataset.csv"))read.csv("final_iacguardian_dataset.csv",stringsAsFactors=FALSE)else make_data()
ui<-dashboardPage(dashboardHeader(title="IaCGuardian | Module 5"),dashboardSidebar(sidebarMenu(menuItem("Dashboard",tabName="dash",icon=icon("gauge-high")),menuItem("Risk Visualization",tabName="risk",icon=icon("chart-column")),menuItem("Architecture",tabName="arch",icon=icon("diagram-project")),menuItem("Workflow",tabName="flow",icon=icon("route")),menuItem("Data Table",tabName="table",icon=icon("table")))),dashboardBody(tags$head(tags$style(HTML("body{font-family:'Segoe UI',Arial}.content-wrapper{background:#eef6ff}.box,.small-box{border-radius:15px}.main-header .navbar,.main-sidebar{background:#071a35}"))),tabItems(
tabItem("dash",h2("IaCGuardian Security Visualization"),fluidRow(valueBoxOutput("assets",3),valueBoxOutput("critical",3),valueBoxOutput("high",3),valueBoxOutput("average",3)),fluidRow(box(width=6,title="Risk Distribution",status="primary",solidHeader=TRUE,plotlyOutput("riskdist",height=350)),box(width=6,title="Risk by Resource",status="info",solidHeader=TRUE,plotlyOutput("resource",height=350)))),
tabItem("risk",h2("Risk Analytics"),fluidRow(box(width=6,title="Risk vs Open Ports",status="warning",solidHeader=TRUE,plotlyOutput("scatter",height=400)),box(width=6,title="Risk vs Dependencies",status="danger",solidHeader=TRUE,plotlyOutput("dependency",height=400)))),
tabItem("arch",h2("IaCGuardian Architecture"),box(width=12,title="Integrated Architecture",status="primary",solidHeader=TRUE,DiagrammeR::grViz("digraph A{graph[rankdir=TB,bgcolor='transparent'];node[shape=box,style='rounded,filled',fontname='Arial',fontsize=14];A[label='Infrastructure / IaC Input',fillcolor='#dbeafe'];B[label='Parsing & Dependency Modelling',fillcolor='#e0f2fe'];C[label='Misconfiguration Detection',fillcolor='#fef3c7'];D[label='Risk Scoring & Classification',fillcolor='#fee2e2'];E[label='Attack Simulation',fillcolor='#fce7f3'];F[label='Security Recommendations',fillcolor='#dcfce7'];G[label='Interactive Visualization',fillcolor='#ede9fe'];A->B->C->D->E->F->G;}"))),
tabItem("flow",h2("End-to-End Workflow"),box(width=12,title="Security Analysis Workflow",status="success",solidHeader=TRUE,DiagrammeR::grViz("digraph W{graph[rankdir=LR,bgcolor='transparent'];node[shape=box,style='rounded,filled',fontname='Arial',fontsize=13];A[label='1 Ingest',fillcolor='#dbeafe'];B[label='2 Validate',fillcolor='#e0f2fe'];C[label='3 Detect',fillcolor='#fef3c7'];D[label='4 Score',fillcolor='#ffedd5'];E[label='5 Simulate',fillcolor='#fee2e2'];F[label='6 Recommend',fillcolor='#dcfce7'];G[label='7 Visualize',fillcolor='#ede9fe'];H[label='8 Report',fillcolor='#cffafe'];A->B->C->D->E->F->G->H;}"))),
tabItem("table",h2("Integrated Visualization Dataset"),box(width=12,title="Asset-Level Data",status="primary",solidHeader=TRUE,DTOutput("table"))))))
server<-function(input,output,session){
 output$assets<-renderValueBox(valueBox(nrow(data),"Total Assets",icon=icon("server"),color="aqua"))
 output$critical<-renderValueBox(valueBox(sum(data$Risk_Level=="Critical"),"Critical Assets",icon=icon("skull-crossbones"),color="red"))
 output$high<-renderValueBox(valueBox(sum(data$Risk_Level=="High"),"High-Risk Assets",icon=icon("triangle-exclamation"),color="yellow"))
 output$average<-renderValueBox(valueBox(round(mean(data$Risk_Score,na.rm=TRUE),2),"Average Risk",icon=icon("gauge-high"),color="green"))
 output$riskdist<-renderPlotly({z<-data%>%count(Risk_Level);z$Risk_Level<-factor(z$Risk_Level,levels=c("Low","Medium","High","Critical"));ggplotly(ggplot(z,aes(Risk_Level,n,fill=Risk_Level))+geom_col()+theme_minimal()+theme(legend.position="none")+labs(x=NULL,y="Assets"))})
 output$resource<-renderPlotly({z<-data%>%group_by(Resource_Type)%>%summarise(Average_Risk=mean(Risk_Score),.groups="drop");ggplotly(ggplot(z,aes(reorder(Resource_Type,Average_Risk),Average_Risk,fill=Resource_Type))+geom_col()+coord_flip()+theme_minimal()+theme(legend.position="none")+labs(x=NULL,y="Average risk"))})
 output$scatter<-renderPlotly(ggplotly(ggplot(data,aes(Open_Ports,Risk_Score,size=Dependency_Count))+geom_point(alpha=.65)+theme_minimal()+labs(x="Open ports",y="Risk score")))
 output$dependency<-renderPlotly(ggplotly(ggplot(data,aes(Dependency_Count,Risk_Score,size=Vulnerability_Count))+geom_point(alpha=.65)+theme_minimal()+labs(x="Dependency count",y="Risk score")))
 output$table<-renderDT(datatable(data,rownames=FALSE,filter="top",extensions="Buttons",options=list(dom="Bfrtip",buttons=c("copy","csv","excel","print"),pageLength=15,scrollX=TRUE)))
}
shinyApp(ui,server)
